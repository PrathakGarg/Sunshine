+#define LI_PINCH_EVENT_BEGIN  0
+#define LI_PINCH_EVENT_UPDATE 1
+#define LI_PINCH_EVENT_END    2
+int LiSendPinchEvent(uint8_t eventType, float span, float centerX, float centerY);
